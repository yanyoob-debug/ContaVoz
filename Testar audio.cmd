@echo off
cd /d "%~dp0"
powershell.exe -NoProfile -Command "$ErrorActionPreference = 'Stop'; $browserJob = $null; try { if (-not (Get-Command java -ErrorAction SilentlyContinue)) { throw 'Instale o Java 17 para iniciar a aplicacao.' }; if (Get-NetTCPConnection -State Listen -LocalPort 18082 -ErrorAction SilentlyContinue) { throw 'A porta 18082 ja esta em uso. Feche a janela de teste anterior antes de tentar novamente.' }; if (-not (Test-Path -LiteralPath 'build/libs/budgeting-audio.jar')) { Write-Host 'Preparando a aplicacao. A primeira execucao pode demorar...'; & .\gradlew.bat bootJar -PaudioTestArchive --no-daemon; if ($LASTEXITCODE -ne 0) { throw 'Nao foi possivel preparar a aplicacao.' }; }; Write-Host ''; Write-Host 'TESTE DE AUDIO - BUDGETING VOICE' -ForegroundColor Yellow; Write-Host 'A API OpenAI pode gerar custos. A chave nao sera salva em arquivo.'; Write-Host 'Os gastos deste teste ficam separados dos dados da demonstracao.'; Write-Host ''; $secret = Read-Host 'Cole sua chave OpenAI e pressione Enter (ela ficara oculta)' -AsSecureString; $env:OPENAI_API_KEY = [System.Net.NetworkCredential]::new('', $secret).Password; $secret.Dispose(); if ([string]::IsNullOrWhiteSpace($env:OPENAI_API_KEY)) { throw 'Nenhuma chave informada. O teste nao foi iniciado.' }; Write-Host 'Iniciando. O navegador sera aberto automaticamente. Mantenha esta janela aberta.'; $browserJob = Start-Job -ScriptBlock { for ($attempt = 0; $attempt -lt 90; $attempt++) { try { $response = Invoke-RestMethod 'http://localhost:18082/api/config' -TimeoutSec 2; if ($response.aiEnabled) { Start-Process 'http://localhost:18082/#voice'; return }; } catch {}; Start-Sleep -Seconds 1; }; }; & java -jar build/libs/budgeting-audio.jar --server.port=18082 --spring.profiles.active=default --spring.web.resources.static-locations=file:./src/main/resources/static/,classpath:/static/ --spring.datasource.url=jdbc:h2:file:./data/audio-test; if ($LASTEXITCODE -ne 0) { throw 'A aplicacao nao iniciou. Confira a mensagem acima.' }; } catch { Write-Host $_.Exception.Message -ForegroundColor Red; } finally { Remove-Item Env:OPENAI_API_KEY -ErrorAction SilentlyContinue; if ($browserJob) { Stop-Job $browserJob -ErrorAction SilentlyContinue; Remove-Job $browserJob -Force -ErrorAction SilentlyContinue }; }; Write-Host 'Teste encerrado. Voce pode fechar esta janela.'; Read-Host 'Pressione Enter para sair' | Out-Null;"

