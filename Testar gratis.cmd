@echo off
cd /d "%~dp0"
powershell.exe -NoProfile -Command "$ErrorActionPreference = 'Stop'; try { if (Get-NetTCPConnection -State Listen -LocalPort 18083 -ErrorAction SilentlyContinue) { Start-Process 'http://localhost:18083/#voice'; exit }; if (-not (Test-Path -LiteralPath 'build/libs/budgeting-free.jar')) { & .\gradlew.bat bootJar -PfreeTestArchive --no-daemon; if ($LASTEXITCODE -ne 0) { throw 'Falha ao preparar a aplicacao.' } }; Write-Host 'MODO GRATUITO - Sem chave e sem chamadas a OpenAI.' -ForegroundColor Green; Write-Host 'Abra http://localhost:18083/#voice no Chrome ou Edge. Mantenha esta janela aberta.'; & java -jar build/libs/budgeting-free.jar --spring.profiles.active=free --server.port=18083 --spring.web.resources.static-locations=file:./src/main/resources/static/,classpath:/static/; } catch { Write-Host $_.Exception.Message -ForegroundColor Red }; Read-Host 'Pressione Enter para sair' | Out-Null"
